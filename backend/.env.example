# Server Port
PORT=5000

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/trustvault?retryWrites=true&w=majority

# JWT Signing Secret
JWT_SECRET=replace_with_a_secure_random_string

# Email Service (Resend or Gmail SMTP)
# Option A: Resend API (Recommended)
EMAIL_SERVICE=resend
RESEND_API_KEY=re_your_api_key

# Option B: Gmail SMTP
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_google_app_password
